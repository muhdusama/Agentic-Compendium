# Copy to .env (never commit .env). Generate each credential independently:
# openssl rand -hex 32
APP_BIND_IP=127.0.0.1
APP_PUBLIC_ORIGIN=https://compendium.example.com
APP_HERMES_ALLOWED_ORIGINS=https://hermes.example.com
APP_READ_TOKEN=replace-with-a-unique-random-64-hex-string
APP_PUBLISH_TOKEN=replace-with-another-unique-random-64-hex-string
APP_OWNER_PASSWORD=replace-with-a-third-unique-random-64-hex-string
APP_HERMES_POLL_SECONDS=300

# Optional: encrypt the stored Hermes password. Keep a copy; losing it means reconnecting Hermes.
# APP_SECRET_KEY=replace-with-a-fourth-unique-random-64-hex-string
# Optional: proxy addresses (IPs or CIDRs) whose X-Forwarded-For is trusted for sign-in throttling.
# APP_TRUSTED_PROXIES=your-proxy-IP-or-CIDR
# Optional: container memory limit (default 2g).
# APP_MEMORY_LIMIT=2g

# Optional: use a reachable LAN DNS resolver if Docker's inherited DNS fails.
# The resolver must resolve your private Hermes name and public push services.
# APP_DNS_SERVER=your-resolver-IP
# COMPOSE_FILE=compose.yaml:compose.dns.yaml
