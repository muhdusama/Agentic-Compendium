# Copy to .env (never commit .env). Generate each credential independently:
# openssl rand -hex 32
APP_BIND_IP=127.0.0.1
APP_PUBLIC_ORIGIN=https://compendium.example.com
APP_HERMES_ALLOWED_ORIGINS=https://hermes.example.com
APP_READ_TOKEN=replace-with-a-unique-random-64-hex-string
APP_PUBLISH_TOKEN=replace-with-another-unique-random-64-hex-string
APP_OWNER_PASSWORD=replace-with-a-third-unique-random-64-hex-string
APP_HERMES_POLL_SECONDS=300
